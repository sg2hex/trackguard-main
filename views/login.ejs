<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/trackguard-icon.png?v=1">
  <link rel="stylesheet" href="/css/theme.css">
  <script>
    try {
      const storedTheme = localStorage.getItem('trackguard-theme');
      document.documentElement.dataset.theme = storedTheme === 'dark' || storedTheme === 'light'
        ? storedTheme
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch {
      document.documentElement.dataset.theme = 'light';
    }
  </script>
  <script src="/js/theme.js" defer></script>
  <title>TrackGuard - Secure Login</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background: radial-gradient(circle at 10% 20%, rgba(37, 99, 235, 0.05) 0%, transparent 40%),
                  radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.05) 0%, transparent 40%),
                  #f1f5f9;
      background-image: radial-gradient(rgba(148, 163, 184, 0.25) 1px, transparent 1px);
      background-size: 24px 24px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      width: 100%;
      max-width: 420px;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      border: 1px solid #e1e8ed;
    }

    .login-header {
      background: linear-gradient(135deg, #1e293b, #0f172a);
      color: #ffffff;
      padding: 32px 24px;
      text-align: center;
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      background: rgba(37, 99, 235, 0.2);
      border: 1px solid rgba(59, 130, 246, 0.5);
      border-radius: 50%;
      margin-bottom: 12px;
    }

    .brand-badge img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }

    .login-header h1 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .login-header p {
      font-size: 13px;
      color: #94a3b8;
      margin-top: 4px;
    }

    .login-body {
      padding: 32px 28px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #334155;
      margin-bottom: 6px;
    }

    .form-control {
      width: 100%;
      padding: 12px 14px;
      font-size: 14px;
      color: #1e293b;
      background-color: #f8fafc;
      border: 1.5px solid #cbd5e1;
      border-radius: 8px;
      outline: none;
      transition: all 0.2s ease-in-out;
    }

    .form-control:focus {
      background-color: #ffffff;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .password-input-wrapper {
      position: relative;
    }

    .password-input-wrapper .form-control {
      padding-right: 48px;
    }

    .password-toggle {
      position: absolute;
      top: 50%;
      right: 12px;
      transform: translateY(-50%);
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      background: transparent;
      color: #2563eb;
      cursor: pointer;
    }

    .password-toggle svg {
      width: 20px;
      height: 20px;
    }

    .password-toggle .eye-off,
    .password-toggle[aria-pressed="true"] .eye {
      display: none;
    }

    .password-toggle[aria-pressed="true"] .eye-off {
      display: block;
    }

    .password-toggle:focus-visible {
      border-radius: 4px;
      outline: 2px solid #2563eb;
      outline-offset: 2px;
    }

    .btn-submit {
      width: 100%;
      padding: 12px;
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      background-color: #2563eb;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.2s ease-in-out, transform 0.1s ease;
      margin-top: 10px;
    }

    .btn-submit:hover {
      background-color: #1d4ed8;
    }

    .btn-submit:active {
      transform: scale(0.99);
    }

    .error-notice {
      background-color: #fef2f2;
      border: 1px solid #fecaca;
      color: #ef4444;
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 13px;
      margin-bottom: 16px;
      text-align: center;
    }

    .login-footer {
      text-align: center;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid #f1f5f9;
    }

    .login-footer a {
      font-size: 13px;
      color: #2563eb;
      text-decoration: none;
      font-weight: 500;
    }

    .login-footer a:hover {
      text-decoration: underline;
    }

    .security-notice {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 11px;
      color: #64748b;
      margin-top: 16px;
    }

    .security-notice svg {
      width: 14px;
      height: 14px;
      stroke: #10b981;
    }

    .rate-limit-overlay {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(15, 23, 42, 0.55);
    }

    .rate-limit-overlay[hidden] {
      display: none;
    }

    .rate-limit-dialog {
      width: 100%;
      max-width: 400px;
      padding: 28px;
      border-radius: 12px;
      background: #ffffff;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2);
      text-align: center;
    }

    .rate-limit-dialog h2 {
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 20px;
    }

    .rate-limit-dialog p {
      margin-bottom: 22px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.5;
    }

    .rate-limit-dialog button {
      padding: 10px 18px;
      border: 0;
      border-radius: 6px;
      background: #2563eb;
      color: #ffffff;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
    }

    .success-notice {
      background-color: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #15803d;
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 13px;
      margin-bottom: 16px;
      text-align: center;
    }
  </style>
</head>
<body>

  <div class="login-card">
    <div class="login-header">
      <div class="brand-badge">
        <img src="/images/trackguard-icon.png?v=1" alt="">
      </div>
      <h1>TrackGuard</h1>
      <p>Role-Based Asset & Inventory System</p>
    </div>

    <div class="login-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-notice"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-notice"><%= success %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control" 
            placeholder="Enter your email" 
            list="saved-accounts"
            autocomplete="on"
            required
          >
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="password-input-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-control" 
              placeholder="Enter your password" 
              autocomplete="current-password"
              required
            >
            <button class="password-toggle" type="button" aria-controls="password" aria-label="Show password" aria-pressed="false">
              <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/>
                <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.6 15.6 0 0 1-3.1 3.9M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.1-.8"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-submit">Sign In</button>

        <div class="login-footer">
          <a href="/forgot-password">Forgot your password?</a>
          <br>
          <a href="/register">Need an account? Sign up here</a>
        </div>

        <div class="security-notice">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Protected by Session Security & Role Access Controls
        </div>
      </form>
    </div>
  </div>

  <script>
    document.querySelectorAll(".password-toggle").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const passwordInput = document.getElementById(toggle.getAttribute("aria-controls"));
        const isVisible = passwordInput.type === "text";
        passwordInput.type = isVisible ? "password" : "text";
        toggle.setAttribute("aria-pressed", String(!isVisible));
        toggle.setAttribute("aria-label", isVisible ? "Show password" : "Hide password");
      });
    });
  </script>

  <% if (typeof rateLimitMessage !== 'undefined' && rateLimitMessage) { %>
    <div class="rate-limit-overlay" role="dialog" aria-modal="true" aria-labelledby="rateLimitTitle">
      <div class="rate-limit-dialog">
        <h2 id="rateLimitTitle">Too many login attempts</h2>
        <p><%= rateLimitMessage %></p>
        <button id="rateLimitDismiss" type="button">Okay</button>
      </div>
    </div>
    <script>
      const rateLimitOverlay = document.querySelector(".rate-limit-overlay");
      const rateLimitDismiss = document.getElementById("rateLimitDismiss");
      rateLimitDismiss.focus();
      rateLimitDismiss.addEventListener("click", () => {
        rateLimitOverlay.hidden = true;
      });
    </script>
  <% } %>

</body>
</html>