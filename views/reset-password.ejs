<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/jpeg" href="/Logo-images/CircleLogo.jpg">
  <title>TrackGuard - Reset Password</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: #f1f5f9;
      background-image: radial-gradient(rgba(148, 163, 184, 0.25) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .card {
      width: 100%;
      max-width: 420px;
      overflow: hidden;
      border: 1px solid #e1e8ed;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.97);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    header {
      padding: 28px 24px;
      background: linear-gradient(135deg, #1e293b, #0f172a);
      color: #ffffff;
      text-align: center;
    }

    header h1 {
      font-size: 22px;
    }

    header p {
      margin-top: 6px;
      color: #cbd5e1;
      font-size: 13px;
    }

    main {
      padding: 28px;
    }

    .notice {
      margin-bottom: 16px;
      padding: 10px 12px;
      border: 1px solid #fecaca;
      border-radius: 6px;
      background: #fef2f2;
      color: #b91c1c;
      font-size: 13px;
      line-height: 1.5;
      text-align: center;
    }

    label {
      display: block;
      margin-bottom: 6px;
      color: #334155;
      font-size: 13px;
      font-weight: 600;
    }

    input {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid #cbd5e1;
      border-radius: 8px;
      background: #f8fafc;
      color: #1e293b;
      font-size: 14px;
    }

    .password-input-wrapper {
      position: relative;
    }

    .password-input-wrapper input {
      padding-right: 48px;
    }

    .password-toggle {
      position: absolute;
      top: 50%;
      right: 12px;
      transform: translateY(-50%);
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: #2563eb;
      cursor: pointer;
    }

    .password-toggle svg {
      width: 20px;
      height: 20px;
    }

    .password-toggle .eye-off,
    .password-toggle[aria-pressed="true"] .eye {
      display: none;
    }

    .password-toggle[aria-pressed="true"] .eye-off {
      display: block;
    }

    .password-toggle:focus-visible {
      border-radius: 4px;
      outline: 2px solid #2563eb;
      outline-offset: 2px;
    }

    .help {
      margin-top: 6px;
      color: #64748b;
      font-size: 12px;
      line-height: 1.5;
    }

    button {
      width: 100%;
      margin-top: 16px;
      padding: 12px;
      border: 0;
      border-radius: 8px;
      background: #2563eb;
      color: #ffffff;
      cursor: pointer;
      font-size: 15px;
      font-weight: 600;
    }

    .back-link {
      display: block;
      margin-top: 20px;
      color: #2563eb;
      font-size: 13px;
      text-align: center;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="card">
    <header>
      <h1>Reset your password</h1>
      <p>Choose a new password for your TrackGuard account</p>
    </header>
    <main>
      <% if (error) { %>
        <div class="notice"><%= error %></div>
        <a class="back-link" href="/forgot-password">Request a new reset link</a>
      <% } else { %>
        <form action="/reset-password/<%= encodeURIComponent(token) %>" method="POST">
          <label for="password">New Password</label>
          <div class="password-input-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              minlength="6"
              maxlength="12"
              pattern="(?=.*[0-9])(?=.*[a-z])(?=.*[A-Z])(?=.*[^A-Za-z0-9\s])\S{6,12}"
              title="Use 6-12 characters with a number, uppercase letter, lowercase letter, and special character. Do not use spaces."
              autocomplete="new-password"
              required
            >
            <button class="password-toggle" type="button" aria-controls="password" aria-label="Show password" aria-pressed="false">
              <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/>
                <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.6 15.6 0 0 1-3.1 3.9M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.1-.8"/>
              </svg>
            </button>
          </div>
          <p class="help">Use 6-12 characters, including a number, uppercase and lowercase letters, and a special character. No spaces.</p>
          <button type="submit">Save new password</button>
        </form>
      <% } %>
      <a class="back-link" href="/login">Back to sign in</a>
    </main>
  </div>
  <script>
    document.querySelectorAll(".password-toggle").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const passwordInput = document.getElementById(toggle.getAttribute("aria-controls"));
        const isVisible = passwordInput.type === "text";
        passwordInput.type = isVisible ? "password" : "text";
        toggle.setAttribute("aria-pressed", String(!isVisible));
        toggle.setAttribute("aria-label", isVisible ? "Show password" : "Hide password");
      });
    });
  </script>
</body>
</html>
