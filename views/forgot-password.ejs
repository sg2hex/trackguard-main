<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/trackguard-icon.png?v=1">
  <link rel="stylesheet" href="/css/theme.css">
  <script>
    try {
      const storedTheme = localStorage.getItem('trackguard-theme');
      document.documentElement.dataset.theme = storedTheme === 'dark' || storedTheme === 'light'
        ? storedTheme
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch {
      document.documentElement.dataset.theme = 'light';
    }
  </script>
  <script src="/js/theme.js" defer></script>
  <title>TrackGuard - Forgot Password</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: #f1f5f9;
      background-image: radial-gradient(rgba(148, 163, 184, 0.25) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .card {
      width: 100%;
      max-width: 420px;
      overflow: hidden;
      border: 1px solid #e1e8ed;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.97);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    header {
      padding: 28px 24px;
      background: linear-gradient(135deg, #1e293b, #0f172a);
      color: #ffffff;
      text-align: center;
    }

    header h1 {
      font-size: 22px;
    }

    header p {
      margin-top: 6px;
      color: #cbd5e1;
      font-size: 13px;
    }

    main {
      padding: 28px;
    }

    main > p {
      margin-bottom: 18px;
      color: #475569;
      font-size: 14px;
      line-height: 1.5;
    }

    label {
      display: block;
      margin-bottom: 6px;
      color: #334155;
      font-size: 13px;
      font-weight: 600;
    }

    input {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid #cbd5e1;
      border-radius: 8px;
      background: #f8fafc;
      color: #1e293b;
      font-size: 14px;
    }

    button {
      width: 100%;
      margin-top: 16px;
      padding: 12px;
      border: 0;
      border-radius: 8px;
      background: #2563eb;
      color: #ffffff;
      cursor: pointer;
      font-size: 15px;
      font-weight: 600;
    }

    .notice {
      margin-bottom: 16px;
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 13px;
      line-height: 1.5;
      text-align: center;
    }

    .error {
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #b91c1c;
    }

    .message {
      border: 1px solid #bbf7d0;
      background: #f0fdf4;
      color: #15803d;
    }

    .back-link {
      display: block;
      margin-top: 20px;
      color: #2563eb;
      font-size: 13px;
      text-align: center;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="card">
    <header>
      <h1>Forgot your password?</h1>
      <p>TrackGuard account recovery</p>
    </header>
    <main>
      <p>Enter the email address associated with your account. If it is registered, we will email you a one-time reset link.</p>
      <% if (error) { %><div class="notice error"><%= error %></div><% } %>
      <% if (message) { %><div class="notice message"><%= message %></div><% } %>
      <form action="/forgot-password" method="POST">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" autocomplete="email" maxlength="254" required>
        <button type="submit">Send reset link</button>
      </form>
      <a class="back-link" href="/login">Back to sign in</a>
    </main>
  </div>
</body>
</html>
